# -------------------------------------------------------------------
# AIOps — Git Ignore
# -------------------------------------------------------------------

# ── Containerlab runtime ──
*clab-*/

# ── Terraform ──
*.terraform.lock.hcl
*.terraform/
*.tfstate*

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ── Environment / Secrets ──
*.env
!.env.example
# !netbox/.env

# ── Docker volumes (if bind-mounted) ──
netbox/postgres_data/
netbox/redis_data/

# ── Memory bank (project context) ──
*memory-bank/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db